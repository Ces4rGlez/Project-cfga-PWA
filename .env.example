# ============================================================
# Plantilla de variables de entorno para desarrollo local
# INSTRUCCIONES:
#   1. Copia este archivo como ".env" en la raiz del proyecto
#   2. Reemplaza los valores de marcador (<...>) con los valores reales
#   3. NUNCA subas ".env" al repositorio (ya esta en .gitignore)
# ============================================================

# --- GestoPago / PuntoRed ---
GESTOPAGO_URL=https://gestopago.portalventas.net
GESTOPAGO_ID_DISTRIBUIDOR=83
GESTOPAGO_CODIGO_DISPOSITIVO=GPS83-TPV-17
GESTOPAGO_PASSWORD=<PASSWORD_GESTOPAGO>
GESTOPAGO_UNIDAD=083
GESTOPAGO_AES_KEY=<AES_256_KEY_BASE64_PROPORCIONADA_POR_PUNTORED>
GESTOPAGO_AES_IV=<AES_IV_BASE64_PROPORCIONADO_POR_PUNTORED>
GESTOPAGO_SIMULACION=true

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_gestopago
DB_USER=postgres
DB_PASS=<PASSWORD_POSTGRES>

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---
JWT_SECRET=<SECRETO_JWT_MINIMO_32_CARACTERES_ALEATORIOS>
JWT_EXPIRATION_MS=3600000

